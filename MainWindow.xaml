<Window x:Class="SlideshowWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slideshow Widget" 
        Icon="icon.png"
        Height="400" Width="400"
        MinHeight="120" MinWidth="120"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged">

    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Select Folder..." Click="SelectFolder_Click"/>
            <MenuItem x:Name="RecurseSubdirectoriesMenuItem" 
                      Header="Recurse Subdirectories" 
                      IsCheckable="True" 
                      IsChecked="False" 
                      Click="RecurseSubdirectories_Click"/>
            <MenuItem x:Name="RandomizeOrderMenuItem" 
                      Header="Randomize Order" 
                      IsCheckable="True" 
                      IsChecked="False" 
                      Click="RandomizeOrder_Click"/>
            <Separator/>
            
            <MenuItem x:Name="PlayPauseMenuItem" Header="Pause Slideshow" Click="PlayPause_Click"/>
            <MenuItem Header="Previous Image" Click="PrevImage_Click"/>
            <MenuItem Header="Next Image" Click="NextImage_Click"/>
            <Separator/>

            <!-- Interval Selection -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="200" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Interval" FontWeight="SemiBold"/>
                            <TextBlock x:Name="IntervalValueText" Text="5s" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="IntervalSlider" 
                                Minimum="1" Maximum="60" Value="5"
                                SmallChange="1" LargeChange="5"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="IntervalSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="More Intervals...">
                <MenuItem Header="10 Seconds" Click="IntervalPreset_Click" Tag="10"/>
                <MenuItem Header="30 Seconds" Click="IntervalPreset_Click" Tag="30"/>
                <MenuItem Header="1 Minute" Click="IntervalPreset_Click" Tag="60"/>
                <MenuItem Header="2 Minutes" Click="IntervalPreset_Click" Tag="120"/>
                <MenuItem Header="5 Minutes" Click="IntervalPreset_Click" Tag="300"/>
                <MenuItem Header="10 Minutes" Click="IntervalPreset_Click" Tag="600"/>
                <MenuItem Header="30 Minutes" Click="IntervalPreset_Click" Tag="1800"/>
            </MenuItem>

            <Separator/>

            <!-- Opacity Slider -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="200" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Opacity" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OpacityValueText" Text="100%" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="OpacitySlider" 
                                Minimum="0.1" Maximum="1.0" Value="1.0"
                                SmallChange="0.05" LargeChange="0.1"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <Separator/>
            <MenuItem x:Name="AlwaysOnTopMenuItem" 
                      Header="Always on Top" 
                      IsCheckable="True" 
                      IsChecked="False" 
                      Click="AlwaysOnTop_Click"/>
            <MenuItem x:Name="ShadowMenuItem" 
                      Header="Window Shadow" 
                      IsCheckable="True" 
                      IsChecked="True" 
                      Click="Shadow_Click"/>

            <Separator/>
            <MenuItem Header="New Window" Click="NewWindow_Click"/>
            <MenuItem Header="Close Widget" Click="CloseWidget_Click"/>
            <MenuItem Header="Exit All" Click="ExitAll_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Background="#01000000">
        <!-- Near-invisible background ensures mouse clicks register -->
        <Border x:Name="PlaceholderBorder"
                Background="#20000000"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                CornerRadius="8"
                Margin="14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="315" Color="Black" Opacity="0.30" RenderingBias="Performance"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="📷" FontSize="36" HorizontalAlignment="Center" Foreground="#80FFFFFF"/>
                <TextBlock Text="Right-click to select folder"
                           Foreground="#A0FFFFFF"
                           FontSize="13"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Slideshow Image with faint 3D drop shadow -->
        <Image x:Name="SlideshowImage" 
               Stretch="Uniform" 
               Margin="14"
               RenderOptions.BitmapScalingMode="HighQuality"
               HorizontalAlignment="Center" 
               VerticalAlignment="Center">
            <Image.Effect>
                <DropShadowEffect x:Name="ImageDropShadow"
                                  BlurRadius="16" 
                                  ShadowDepth="4" 
                                  Direction="315" 
                                  Color="Black" 
                                  Opacity="0.35" 
                                  RenderingBias="Performance"/>
            </Image.Effect>
        </Image>
    </Grid>
</Window>
